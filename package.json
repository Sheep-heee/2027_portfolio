{
  "name": "portfolio-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next-sanity": "13.3.4",
    "sanity": "6.18.0",
    "styled-components": "6.5.3",
    "server-only": "0.0.1",
    "vinext": "1.0.1",
    "react-server-dom-webpack": "19.3.0",
    "@vinext/cloudflare": "1.0.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "vite": "8.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "@cloudflare/vite-plugin": "1.63.0",
    "wrangler": "4.148.0"
  },
  "type": "module"
}
